[Unit]
Description=power-map hourly per-key API request-volume anomaly check (issue #294)
After=network.target

[Service]
Type=oneshot
User=exedev
WorkingDirectory=/home/exedev/power-map
EnvironmentFile=/etc/power-map/.env
EnvironmentFile=-/home/exedev/power-map/.env
# Requires uv on PATH (/usr/local/bin/uv); see infra/power-map.service.
# Logs a WARNING per key at/above the threshold (default 5000/hr; env
# API_ANOMALY_HOURLY_THRESHOLD) and exits 2 — the unit shows as failed, so
# anomalies surface in `systemctl --failed` and can drive OnFailure= later.
ExecStart=uv run python -m scripts.check_api_anomalies
