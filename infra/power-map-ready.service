[Unit]
Description=power-map readiness probe guard (issue #347)
After=network.target

[Service]
Type=oneshot
User=exedev
WorkingDirectory=/home/exedev/power-map
EnvironmentFile=/etc/power-map/.env
EnvironmentFile=-/home/exedev/power-map/.env
# Requires uv on PATH (/usr/local/bin/uv); see infra/power-map.service.
#
# Polls GET /ready on the production worker. A failing run exits 3, so the unit
# shows in `systemctl --failed` (the ambient signal the SessionStart hook reads)
# and checks in `not-ready` below; the reason slug is in the journal. The next
# green run's `ok` clears the fault (#566 retired the issue it used to open).
#
# Deliberately probes localhost, not the public proxy: the failure class this
# exists for (2026-08-09 — pool_timeout for 35 min, detected by a human) lives
# in the app->DB direction, which a local probe sees. An external monitor would
# add proxy-layer coverage as a separate, additive job.
#
# Two probes 10s apart per run means a lone blip stays quiet; worst case is
# ~30s of probing.
ExecStart=uv run python -m scripts.check_ready
TimeoutStartSec=120

# After every run, ok or alert, a check-in with co-status (#566): a failed run
# reaches a person through Notifier, and a run that never happens goes `missing`.
# Best-effort (`-`, and the hook always exits 0); never changes this unit's result.
# The key is a credential, never an env var; SetCredential= (a lone newline,
# read as "no key") is the fallback that keeps a missing key file from failing
# the unit (243).
# co-status monitor: co-power-map-ready (CannObserv/status#36)
Environment=STATUS_MONITOR_ID=
Environment=STATUS_EXIT_KINDS=3:not-ready
LoadCredential=status-checkin:/etc/power-map/status-checkin.key
SetCredential=status-checkin:\n
ExecStopPost=-/usr/bin/python3 /home/exedev/power-map/scripts/status_checkin.py %n
