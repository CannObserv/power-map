[Unit]
Description=power-map daily assignment-relationship window reconcile audit (issue #301)
After=network.target

[Service]
Type=oneshot
User=exedev
WorkingDirectory=/home/exedev/power-map
EnvironmentFile=/etc/power-map/.env
EnvironmentFile=-/home/exedev/power-map/.env
# Requires uv on PATH (/usr/local/bin/uv); see infra/power-map.service.
# Report-only (no --execute): flags active role_assignment_relationships edges whose
# window drifted outside the intersection of both endpoint assignment windows, or
# whose endpoint is archived. The observation path records freely and the endpoint
# cascade trigger clamps on write; this is the steady-state backstop that reconciles
# drift, sharing the trigger's exact clamp rule. Read-only in this mode — a human
# runs `--execute` to clamp/archive after reviewing the report.
ExecStart=uv run python -m scripts.audit_assignment_relationship_windows

# After every run, ok or alert, a check-in with co-status (#566): a failed run
# reaches a person through Notifier, and a run that never happens goes `missing`.
# Best-effort (`-`, and the hook always exits 0); never changes this unit's result.
# The key is a credential, never an env var; SetCredential= (a lone newline,
# read as "no key") is the fallback that keeps a missing key file from failing
# the unit (243).
# co-status monitor: co-power-map-assignment-rel-windows (CannObserv/status#36)
Environment=STATUS_MONITOR_ID=
Environment=STATUS_EXIT_KINDS=3:drift
LoadCredential=status-checkin:/etc/power-map/status-checkin.key
SetCredential=status-checkin:\n
ExecStopPost=-/usr/bin/python3 /home/exedev/power-map/scripts/status_checkin.py %n
