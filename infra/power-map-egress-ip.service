[Unit]
Description=power-map egress-IP drift guard (issue #410)
After=network.target

[Service]
Type=oneshot
User=exedev
WorkingDirectory=/home/exedev/power-map
EnvironmentFile=/etc/power-map/.env
EnvironmentFile=-/home/exedev/power-map/.env
# Requires uv on PATH (/usr/local/bin/uv); see infra/power-map.service.
#
# Compares this host's public egress IP against the cluster's live Trusted
# Sources, read from the DO API using DO_API_TOKEN (/etc/power-map/.env). The
# cluster gates on source IP, so a rotation takes every DB-backed route down —
# 2026-08-09, 67.213.124.9 -> 69.67.149.183, ~35 minutes.
#
# The API is authoritative: nothing to keep in sync by hand, and it also catches
# our address being removed from the list. EGRESS_EXPECTED_IPS is the fallback
# when there is no token or the API is briefly unreachable.
#
# Exits 3 on drift, so the unit shows in `systemctl --failed` and checks in
# `drift` below; the journal names the new address, which is the whole of the
# fix (#566 retired the issue it used to open). Losing every lookup service is
# NOT drift: it logs a WARNING and exits 0 rather than alerting about someone
# else's outage.
ExecStart=uv run python -m scripts.check_egress_ip
TimeoutStartSec=120

# After every run, ok or alert, a check-in with co-status (#566): a failed run
# reaches a person through Notifier, and a run that never happens goes `missing`.
# Best-effort (`-`, and the hook always exits 0); never changes this unit's result.
# The key is a credential, never an env var; SetCredential= (a lone newline,
# read as "no key") is the fallback that keeps a missing key file from failing
# the unit (243).
# co-status monitor: co-power-map-egress-ip (CannObserv/status#36)
Environment=STATUS_MONITOR_ID=
Environment=STATUS_EXIT_KINDS=3:drift
LoadCredential=status-checkin:/etc/power-map/status-api.key
SetCredential=status-checkin:\n
ExecStopPost=-/usr/bin/python3 /home/exedev/power-map/scripts/status_checkin.py %n
