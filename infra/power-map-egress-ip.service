[Unit]
Description=power-map egress-IP drift guard (issue #410)
After=network.target

[Service]
Type=oneshot
User=exedev
WorkingDirectory=/home/exedev/power-map
EnvironmentFile=/etc/power-map/.env
EnvironmentFile=-/home/exedev/power-map/.env
# Requires uv on PATH (/usr/local/bin/uv) and gh (/bin/gh); see infra/power-map.service.
#
# Compares this host's public egress IP against the cluster's live Trusted
# Sources, read from the DO API using DO_API_TOKEN (/etc/power-map/.env). The
# cluster gates on source IP, so a rotation takes every DB-backed route down —
# 2026-08-09, 67.213.124.9 -> 69.67.149.183, ~35 minutes.
#
# The API is authoritative: nothing to keep in sync by hand, and it also catches
# our address being removed from the list. EGRESS_EXPECTED_IPS is the fallback
# when there is no token or the API is briefly unreachable.
#
# Exits 3 on drift, so the unit shows in `systemctl --failed`, and opens a
# single `egress-ip-drift` GitHub issue carrying the new address — which is
# the whole of the fix. Losing every lookup service is NOT drift: it logs a
# WARNING and exits 0 rather than alerting about someone else's outage.
ExecStart=uv run python -m scripts.check_egress_ip
TimeoutStartSec=120
