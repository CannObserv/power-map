[Unit]
Description=power-map daily OpenAPI parity check (live /openapi.json vs committed snapshot) (issue #618)
After=network.target

[Service]
Type=oneshot
User=exedev
WorkingDirectory=/home/exedev/power-map
EnvironmentFile=/etc/power-map/.env
EnvironmentFile=-/home/exedev/power-map/.env
# Requires uv on PATH (/usr/local/bin/uv); see infra/power-map.service.
# Fetches GET /openapi.json from the production workers on localhost and
# compares it with clients/python/openapi.json in this checkout, the deployed
# commit. Exit 3 on a difference, naming what differs in the journal, so the
# unit lands in `systemctl --failed`. That catches a schema that depends on
# runtime configuration, a deploy that skipped the snapshot gate, and a pull
# with no restart. Exit 1 when the schema cannot be fetched.
# Exit 4 when v<served version> is missing on GitHub or tags a commit whose
# snapshot differs (#631); skipped within 2 h of power-map.service starting, or
# when GitHub is unreachable (unauthenticated REST API; the repo is public).
# Read-only: HTTP only, no DB, no writes; it alerts through the check-in below.
ExecStart=uv run python -m scripts.check_openapi_parity
TimeoutStartSec=120

# After every run, ok or alert, a check-in with co-status (#566): a failed run
# reaches a person through Notifier, and a run that never happens goes `missing`.
# Best-effort (`-`, and the hook always exits 0); never changes this unit's result.
# The key is a credential, never an env var; SetCredential= (a lone newline,
# read as "no key") is the fallback that keeps a missing key file from failing
# the unit (243).
# co-status monitor: co-power-map-openapi-parity (CannObserv/status#36)
Environment=STATUS_MONITOR_ID=
Environment=STATUS_EXIT_KINDS=1:unfetchable,3:drift,4:untagged
LoadCredential=status-checkin:/etc/power-map/status-api.key
SetCredential=status-checkin:\n
ExecStopPost=-/usr/bin/python3 /home/exedev/power-map/scripts/status_checkin.py %n
