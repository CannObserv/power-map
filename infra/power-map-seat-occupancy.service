[Unit]
Description=power-map daily seat-occupancy ratchet (issue #506)
After=network.target

[Service]
Type=oneshot
User=exedev
WorkingDirectory=/home/exedev/power-map
EnvironmentFile=/etc/power-map/.env
EnvironmentFile=-/home/exedev/power-map/.env
# Requires uv on PATH (/usr/local/bin/uv); see infra/power-map.service.
# Counts pairs of live assignments where two different people hold one
# single-occupancy role (role_types.occupancy) over strictly overlapping spans;
# a same-day handoff is not a finding. Logs every pair. A ratchet: exits 3 only
# when the count rises above the script's BASELINE, so the unit shows as failed
# in `systemctl --failed` on a new concurrent holder, not on the known backlog.
# Read-only.
ExecStart=uv run python -m scripts.audit_seat_occupancy

# After every run, ok or alert, a check-in with co-status (#566): a failed run
# reaches a person through Notifier, and a run that never happens goes `missing`.
# Best-effort (`-`, and the hook always exits 0); never changes this unit's result.
# The key is a credential, never an env var; SetCredential= (a lone newline,
# read as "no key") is the fallback that keeps a missing key file from failing
# the unit (243).
# co-status monitor: co-power-map-seat-occupancy (CannObserv/status#36)
Environment=STATUS_MONITOR_ID=
Environment=STATUS_EXIT_KINDS=3:ratchet
LoadCredential=status-checkin:/etc/power-map/status-checkin.key
SetCredential=status-checkin:\n
ExecStopPost=-/usr/bin/python3 /home/exedev/power-map/scripts/status_checkin.py %n
