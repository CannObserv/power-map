[Unit]
Description=power-map daily schema-parity audit (prod vs reference) (issues #315, #331, #632)
After=network.target

[Service]
Type=oneshot
User=exedev
WorkingDirectory=/home/exedev/power-map
EnvironmentFile=/etc/power-map/.env
EnvironmentFile=-/home/exedev/power-map/.env
# Requires uv on PATH (/usr/local/bin/uv); see infra/power-map.service.
# Snapshots every constraint (pg_get_constraintdef), function (pg_get_functiondef),
# and trigger (pg_get_triggerdef) on the reference DB (PARITY_REFERENCE_URL,
# default TEST_DATABASE_URL) and on prod (DATABASE_URL), and exits 3 when prod is
# missing or disagrees on any reference object — the CREATE TABLE IF NOT EXISTS
# inline-constraint drift class (#307/#312/#315) plus the CREATE OR REPLACE
# function/trigger body-drift window (#331; extension-owned/internal excluded,
# version-sensitive kinds skipped on a PG-major mismatch). Exit 3 (not 2) stays
# distinct from argparse usage errors; the unit shows as failed, so drift
# surfaces in `systemctl --failed` and can drive OnFailure= later.
# A reference-only object the deployed src/core/schema.sql (this checkout's) does
# not declare is the reference running ahead of a deploy (#632): exit 4, a journal
# WARNING, success here. Past 3 consecutive daily runs it escalates to exit 3;
# the per-object streaks live in data/schema_parity/reference_ahead.json.
# Read-only on both databases; the state file is its only write.
ExecStart=uv run python -m scripts.audit_schema_constraint_parity
SuccessExitStatus=4
