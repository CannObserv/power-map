[Unit]
Description=power-map nightly pull of usa-wa published dataset snapshots (issue #496)
After=network.target

[Service]
Type=oneshot
User=exedev
WorkingDirectory=/home/exedev/power-map
EnvironmentFile=/etc/power-map/.env
EnvironmentFile=-/home/exedev/power-map/.env
# Requires uv on PATH (/usr/local/bin/uv); see infra/power-map.service.
# Requires USA_WA_TOKEN — an exe.dev VM bearer token for usa-wa's private
# proxy. Without it the script exits 2 before making a request rather than
# collecting a login page (see the module docstring).
#
# Writes only into data/usa_wa_snapshots/, never the database; the gated step
# is the applier (#499). Takes no flags: the subscription is the pins in the
# mapping project's sources.yml (#536). Exits 1 when a dataset failed
# verification, published a contract its pin refuses, was subscribed but absent
# from the catalog, or the publisher is past the `stale_after` it published
# (#551) — so all four reach `systemctl --failed` instead of passing as a quiet
# night. The last two are the ones that look most like one: every dataset then
# reads `unchanged`.
ExecStart=uv run python -m scripts.pull_datasets

# After every run, ok or alert, a check-in with co-status (#566): a failed run
# reaches a person through Notifier, and a run that never happens goes `missing`.
# Best-effort (`-`, and the hook always exits 0); never changes this unit's result.
# The key is a credential, never an env var; SetCredential= (a lone newline,
# read as "no key") is the fallback that keeps a missing key file from failing
# the unit (243).
# co-status monitor: co-power-map-datasets-pull (CannObserv/status#36)
Environment=STATUS_MONITOR_ID=
Environment=STATUS_EXIT_KINDS=2:unconfigured
LoadCredential=status-checkin:/etc/power-map/status-api.key
SetCredential=status-checkin:\n
ExecStopPost=-/usr/bin/python3 /home/exedev/power-map/scripts/status_checkin.py %n
