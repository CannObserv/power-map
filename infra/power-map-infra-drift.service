[Unit]
Description=power-map daily infra drift check (infra/ vs the installed copies) (issue #560)

[Service]
Type=oneshot
User=exedev
WorkingDirectory=/home/exedev/power-map
# Requires uv on PATH (/usr/local/bin/uv); see infra/power-map.service.
# Compares every file infra/installed.toml lists (this checkout's, the deployed
# commit) with its installed copy under /etc, and every power-map* unit or
# drop-in under /etc/systemd/system with the manifest. Exit 3 when a copy's
# directives differ, a copy is missing, an installed unit has no repo file, or
# an installed unit lacks the .wants/ link its WantedBy= asks for (never
# enabled), with the diff in the journal, so the unit lands in `systemctl --failed`.
# A copy that differs in comments or blank lines only is exit 4, a journal
# WARNING, success here. Exit 1 on an unreadable copy or a manifest that does
# not match infra/. Read-only and unprivileged; it never installs anything.
ExecStart=uv run python -m scripts.check_infra_drift
SuccessExitStatus=4
TimeoutStartSec=120

# After every run, ok or alert, a check-in with co-status (#566): a failed run
# reaches a person through Notifier, and a run that never happens goes `missing`.
# Best-effort (`-`, and the hook always exits 0); never changes this unit's result.
# The key is a credential, never an env var; SetCredential= (a lone newline,
# read as "no key") is the fallback that keeps a missing key file from failing
# the unit (243).
# co-status monitor: co-power-map-infra-drift (CannObserv/status#36)
Environment=STATUS_MONITOR_ID=01M4RF3V1B7N7SWKGCK0CVMPB9
Environment=STATUS_EXIT_KINDS=1:unreadable,3:drift
LoadCredential=status-checkin:/etc/power-map/status-api.key
SetCredential=status-checkin:\n
ExecStopPost=-/usr/bin/python3 /home/exedev/power-map/scripts/status_checkin.py %n
