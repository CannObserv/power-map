{
  "name": "power-map",
  "version": "0.69.3",
  "description": "Web service for mapping political and corporate power",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test:js": "vitest run",
    "test:sh": "bats tests/sh",
    "test:js:watch": "vitest",
    "lint:js": "eslint src/static/admin tests/js",
    "lint:js:fix": "eslint src/static/admin tests/js --fix",
    "format:js": "prettier --write \"src/static/admin/**/*.js\" \"tests/js/**/*.test.js\" \"*.config.js\"",
    "format:js:check": "prettier --check \"src/static/admin/**/*.js\" \"tests/js/**/*.test.js\" \"*.config.js\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/eslint-plugin": "^1.6.28",
    "bats": "^1.13.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^14.0.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.8.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
